{{ if eq .chezmoi.os "windows" -}}
# Aliases for modern coreutils
Set-Alias ls eza
Set-Alias cat bat

# Mise (Language Manager)
(&mise activate pwsh) | Out-String | Invoke-Expression

# Starship
Invoke-Expression (&starship init powershell)

# Modules
Import-Module PSReadLine
Import-Module PSFzf

# FZF Hotkeys
Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t'
Set-PsFzfOption -PSReadlineChordSetLocation 'Alt+c'

# Atuin (History)
atuin init powershell --disable-up-arrow | Out-String | Invoke-Expression

# Carapace (Command Autocomplete dropdowns)
Set-PSReadLineOption -Colors @{ "Selection" = "`e[7m" }
Set-PSReadlineKeyHandler -Key Tab -Function MenuComplete
$ENV:CARAPACE_BRIDGES = 'zsh,fish,bash,inshellisense'
carapace _carapace | Out-String | Invoke-Expression

# Zoxide (cd replacement)
Invoke-Expression (& { (zoxide init --cmd cd powershell | Out-String) })
{{ end -}}
